[Unit]
Description=LoIl Web Dashboard
After=network.target

[Service]
Type=simple
# 실제 서버에 맞게 바꿀 것 — 배포 경로/유저
User=loil
WorkingDirectory=/opt/loil
ExecStart=/opt/loil/venv/bin/python -u -m uvicorn web.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/loil/logs/web.log
StandardError=append:/opt/loil/logs/web.log

[Install]
WantedBy=multi-user.target
