[Unit]
Description=LoIl Discord Bot
After=network.target

[Service]
Type=simple
# 실제 서버에 맞게 바꿀 것 — 배포 경로/유저
User=loil
WorkingDirectory=/opt/loil
ExecStart=/opt/loil/venv/bin/python -u -m bot.main
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/loil/logs/bot.log
StandardError=append:/opt/loil/logs/bot.log

[Install]
WantedBy=multi-user.target
